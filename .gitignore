# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Cloudflare tunnel credentials
*.cloudflared/
cloudflared/*.json

# Local data that must not be committed
data/raw/
results/scratch/
# Test sets and hand-written cases stay off GitHub (course rule; metrics.md):
# only data/test/LOCK.md is committed, the files are shared with the team.
data/test/*
!data/test/.gitkeep
!data/test/LOCK.md
data/protected/
data/*.db
# Eval harness: model answers and event logs hold test-derived text, so they
# are shared with the locked test set, never pushed. Results CSVs, manifests
# and summaries hold no message text and are committed.
results/cache/
results/events/
results/demo/
results/fake_*.csv

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*.docx

# Planning documents kept outside the repo (shared separately)
/*.docx

# Local Claude Code settings
.claude/

# Server logs
logs/

# Model Weights
# Very large files that would have to be loaded manually into the server. These are not needed for the code to run, and are not shared on GitHub.
src/models/fine_tuning
